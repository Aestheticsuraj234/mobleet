# Copy this file to `.env` and fill in real values.

# A 32+ character random string used to sign sessions.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-char-random-string

# Optional: full base URL of your auth server (set in production).
# In Expo dev mode this is auto-detected from the Metro hostUri.
# BETTER_AUTH_URL=https://your-domain.com

# --- GitHub OAuth ---
# Create at https://github.com/settings/developers
# Authorization callback URL (dev, replace IP with `expo start` LAN IP):
#   http://192.168.X.X:8081/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):
#   http://192.168.X.X:8081/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
